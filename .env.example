# ==============================================================================
# Application
# ==============================================================================
APP_NAME="Knowledge Base RAG"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false

# ==============================================================================
# Server
# ==============================================================================
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# PostgreSQL
# ==============================================================================
# Inside Docker, other containers reach Postgres via the service name "postgres".
# If you ever run the app OUTSIDE docker (e.g. `make run` on your laptop),
# change POSTGRES_HOST to "localhost" instead.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kb_admin
POSTGRES_PASSWORD=kb_dev_password
POSTGRES_DB=knowledge_base

# ==============================================================================
# Redis
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==============================================================================
# Qdrant
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=kb_
QDRANT_DEFAULT_TOP_K=10

# ==============================================================================
# Groq LLM (used starting Module 15)
# ==============================================================================
GROQ_API_KEY=change-me

SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
FRONTEND_BASE_URL=http://localhost:3000

LOCAL_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt,md,html,csv

DEFAULT_CHUNK_SIZE_TOKENS=500
DEFAULT_CHUNK_OVERLAP_TOKENS=50
TOKENIZER_ENCODING=cl100k_base

PRIMARY_EMBEDDING_MODEL=BAAI/bge-m3
FALLBACK_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MODEL_CACHE_DIR=./data/models

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=kb_
QDRANT_DEFAULT_TOP_K=10

HYBRID_DENSE_WEIGHT_RRF_K=60
HYBRID_TOP_K_PER_METHOD=20

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_CACHE_DIR=./data/models
RERANKER_BATCH_SIZE=16

DEDUPLICATION_SIMILARITY_THRESHOLD=0.92
MAX_CONTEXT_TOKENS=4000

MAX_CONVERSATION_HISTORY_MESSAGES=10

GROQ_API_KEY=your-real-groq-api-key-here
PRIMARY_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=10

EMBEDDING_CACHE_TTL_SECONDS=86400
RAG_RESPONSE_CACHE_TTL_SECONDS=300
CACHE_ENABLED=true

OTEL_ENABLED=true
OTEL_SERVICE_NAME=knowledge-base-rag
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
METRICS_ENABLED=true
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000