# ==============================================================================
# Application
# ==============================================================================
APP_NAME="Knowledge Base RAG"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false

# ==============================================================================
# Server
# ==============================================================================
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# PostgreSQL
# ==============================================================================
# Inside Docker, other containers reach Postgres via the service name "postgres".
# If you ever run the app OUTSIDE docker (e.g. `make run` on your laptop),
# change POSTGRES_HOST to "localhost" instead.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kb_admin
POSTGRES_PASSWORD=kb_dev_password
POSTGRES_DB=knowledge_base

# ==============================================================================
# Redis
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==============================================================================
# Qdrant
# ==============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ==============================================================================
# Groq LLM (used starting Module 15)
# ==============================================================================
GROQ_API_KEY=change-me

SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
FRONTEND_BASE_URL=http://localhost:3000

LOCAL_STORAGE_PATH=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt,md,html,csv